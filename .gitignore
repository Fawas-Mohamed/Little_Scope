# Little Scoop: React + Vite frontend

# Installed dependencies (recreate with npm ci from frontend/package-lock.json)
frontend/node_modules/

# Vite production output and local preview artifacts
frontend/dist/
frontend/.vite/

# Local environment variables and machine-specific overrides
# Keep .env.example or other documented templates tracked.
.env
.env.*
!.env.example
!.env.*.example
frontend/.env
frontend/.env.*
!frontend/.env.example
!frontend/.env.*.example

# Logs and package-manager debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test, coverage, and tool caches (if added later)
coverage/
.nyc_output/
.cache/
.parcel-cache/
.eslintcache
.vite/

# Temporary files and operating-system metadata
*.tmp
*.temp
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini

# Editor and IDE settings (shared project configuration may be added explicitly)
.vscode/
.idea/
*.code-workspace

frontend/qa/screenshots/
frontend/qa/*.json
test-results/
playwright-report/
